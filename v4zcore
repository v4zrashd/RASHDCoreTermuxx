#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  V4Z Core - modular Termux dev environment manager
#  by V4Z RASHD | https://t.me/rashdteem
#
#  One CLI to install, list, inspect and remove Termux
#  development modules (languages, tools, editors, databases,
#  AI assistants, shell). Original tool; Bash + pkg/npm only.
# ============================================================

VERSION="1.1"
DRY_RUN=0

GREEN="\033[92m"; CYAN="\033[96m"; YELLOW="\033[93m"
RED="\033[91m"; DIM="\033[2m"; BOLD="\033[1m"; RESET="\033[0m"

say()  { printf '%b\n' "$1"; }
info() { say "${CYAN}$1${RESET}"; }
ok()   { say "${GREEN}$1${RESET}"; }
warn() { say "${YELLOW}$1${RESET}"; }
err()  { say "${RED}$1${RESET}"; }

banner() {
  say "${GREEN}========================================================${RESET}"
  say "${GREEN}${BOLD}  V4Z Core  v${VERSION}  -  Termux Dev Environment${RESET}"
  say "${DIM}  by V4Z RASHD  |  https://t.me/rashdteem${RESET}"
  say "${GREEN}========================================================${RESET}"
}

# Run a command, or just print it in dry-run mode.
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '%b\n' "${DIM}[dry-run] + $*${RESET}"
  else
    "$@"
  fi
}

# ---------------------------------------------------------------------------
# Module catalogue (original V4Z mapping of well-known Termux packages)
# ---------------------------------------------------------------------------

MODULE_ORDER="lang dev editor db ai shell"

module_tools() {
  case "$1" in
    lang)   echo "python nodejs php golang rust" ;;
    dev)    echo "git curl wget jq fzf bat lsd" ;;
    editor) echo "neovim" ;;
    db)     echo "sqlite postgresql mariadb" ;;
    ai)     echo "opencode cline" ;;
    shell)  echo "zsh" ;;
    *)      echo "" ;;
  esac
}

module_desc() {
  case "$1" in
    lang)   echo "Programming languages: Python, Node.js, PHP, Go, Rust" ;;
    dev)    echo "Everyday developer tools: git, curl, wget, jq, fzf, bat, lsd" ;;
    editor) echo "Code editor: Neovim" ;;
    db)     echo "Databases: SQLite, PostgreSQL, MariaDB" ;;
    ai)     echo "AI coding assistants (via npm): OpenCode, Cline" ;;
    shell)  echo "Z shell with plugin guidance" ;;
    *)      echo "" ;;
  esac
}

# How a tool gets installed: "pkg" (Termux repo) or "npm" (global npm package)
tool_method() {
  case "$1" in
    opencode|cline) echo "npm" ;;
    *)              echo "pkg" ;;
  esac
}

# Package name for pkg / npm
tool_pkg() {
  case "$1" in
    python)     echo "python" ;;
    nodejs)     echo "nodejs" ;;
    php)        echo "php" ;;
    golang)     echo "golang" ;;
    rust)       echo "rust" ;;
    git)        echo "git" ;;
    curl)       echo "curl" ;;
    wget)       echo "wget" ;;
    jq)         echo "jq" ;;
    fzf)        echo "fzf" ;;
    bat)        echo "bat" ;;
    lsd)        echo "lsd" ;;
    neovim)     echo "neovim" ;;
    sqlite)     echo "sqlite" ;;
    postgresql) echo "postgresql" ;;
    mariadb)    echo "mariadb" ;;
    opencode)   echo "opencode-ai" ;;
    cline)      echo "cline" ;;
    zsh)        echo "zsh" ;;
    *)          echo "" ;;
  esac
}

# Binary used to detect whether the tool is present
tool_bin() {
  case "$1" in
    python)     echo "python" ;;
    nodejs)     echo "node" ;;
    php)        echo "php" ;;
    golang)     echo "go" ;;
    rust)       echo "rustc" ;;
    git)        echo "git" ;;
    curl)       echo "curl" ;;
    wget)       echo "wget" ;;
    jq)         echo "jq" ;;
    fzf)        echo "fzf" ;;
    bat)        echo "bat" ;;
    lsd)        echo "lsd" ;;
    neovim)     echo "nvim" ;;
    sqlite)     echo "sqlite3" ;;
    postgresql) echo "psql" ;;
    mariadb)    echo "mariadb" ;;
    opencode)   echo "opencode" ;;
    cline)      echo "cline" ;;
    zsh)        echo "zsh" ;;
    *)          echo "" ;;
  esac
}

tool_installed() {
  local bin
  bin="$(tool_bin "$1")"
  [ -n "$bin" ] && command -v "$bin" >/dev/null 2>&1
}

valid_module() {
  [ -n "$(module_tools "$1")" ]
}

# ---------------------------------------------------------------------------
# install / uninstall
# ---------------------------------------------------------------------------

do_install_tool() {
  local tool="$1" method pkg
  method="$(tool_method "$tool")"
  pkg="$(tool_pkg "$tool")"
  if tool_installed "$tool" && [ "$DRY_RUN" -eq 0 ]; then
    say "  ${DIM}$tool - already installed, skipped${RESET}"
    return 0
  fi
  if [ "$method" = "npm" ]; then
    if ! command -v npm >/dev/null 2>&1 && [ "$DRY_RUN" -eq 0 ]; then
      err "  $tool needs npm. Install Node.js first:  v4zcore install lang --nodejs"
      return 1
    fi
    run npm install -g "$pkg"
  else
    run pkg install -y "$pkg"
  fi
}

do_uninstall_tool() {
  local tool="$1" method pkg
  method="$(tool_method "$tool")"
  pkg="$(tool_pkg "$tool")"
  if [ "$method" = "npm" ]; then
    run npm uninstall -g "$pkg"
  else
    run pkg uninstall -y "$pkg"
  fi
}

# Parse [--tool ...] selectors that follow a module name.
# Prints the selected tools (all module tools when no selector given).
selected_tools() {
  local module="$1"; shift
  if [ "$#" -eq 0 ]; then
    module_tools "$module"
    return 0
  fi
  local out="" t wanted valid
  for t in "$@"; do
    wanted="${t#--}"
    valid=0
    for c in $(module_tools "$module"); do
      [ "$c" = "$wanted" ] && valid=1
    done
    if [ "$valid" -eq 1 ]; then
      out="$out $wanted"
    else
      warn "  (tool '$wanted' is not part of module '$module' - ignored)"
    fi
  done
  echo "$out"
}

shell_plugins_note() {
  say ""
  info "ZSH plugin note:"
  say "  Extra ZSH goodies are available from the Termux repo, e.g."
  say "    pkg install zsh-autosuggestions zsh-syntax-highlighting"
  say "  then load them from your ~/.zshrc, for example:"
  say "    source \$PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  say "  Start the shell with:  zsh"
}

cmd_install() {
  local module="${1:-}"
  if [ -z "$module" ] || ! valid_module "$module"; then
    err "Usage: v4zcore install <module> [--tool ...]"
    say "Modules: $MODULE_ORDER"
    return 1
  fi
  shift
  banner
  info "Installing module: $module ($(module_desc "$module"))"
  local tools
  tools="$(selected_tools "$module" "$@")"
  if [ -z "$tools" ]; then
    warn "Nothing selected to install."
    return 1
  fi
  local t
  for t in $tools; do
    do_install_tool "$t"
  done
  [ "$module" = "shell" ] && shell_plugins_note
  ok "Done."
  return 0
}

cmd_uninstall() {
  local module="${1:-}"
  if [ -z "$module" ] || ! valid_module "$module"; then
    err "Usage: v4zcore uninstall <module> [--tool ...]"
    say "Modules: $MODULE_ORDER   (or run uninstall.sh to remove v4zcore itself)"
    return 1
  fi
  shift
  banner
  info "Removing module: $module"
  local tools
  tools="$(selected_tools "$module" "$@")"
  if [ -z "$tools" ]; then
    warn "Nothing selected to remove."
    return 1
  fi
  local t
  for t in $tools; do
    do_uninstall_tool "$t"
  done
  ok "Done."
  return 0
}

# ---------------------------------------------------------------------------
# list / show
# ---------------------------------------------------------------------------

cmd_list() {
  local module="${1:-}"
  banner
  if [ -z "$module" ]; then
    info "Available modules:"
    local m
    for m in $MODULE_ORDER; do
      printf '  %-8s %s\n' "$m" "$(module_desc "$m")"
    done
    say ""
    say "See the tools inside a module with:  v4zcore list <module>"
    return 0
  fi
  if ! valid_module "$module"; then
    err "Unknown module: $module"
    say "Modules: $MODULE_ORDER"
    return 1
  fi
  info "Module: $module - $(module_desc "$module")"
  local t
  for t in $(module_tools "$module"); do
    if tool_installed "$t"; then
      printf '  %-12s %b\n' "$t" "${GREEN}installed${RESET}"
    else
      printf '  %-12s %b\n' "$t" "${DIM}not installed${RESET}"
    fi
  done
  return 0
}

cmd_show() {
  local module="${1:-}"
  if [ -z "$module" ] || ! valid_module "$module"; then
    err "Usage: v4zcore show <module>"
    say "Modules: $MODULE_ORDER"
    return 1
  fi
  banner
  info "Module: $module"
  say "  $(module_desc "$module")"
  say ""
  say "  Tools and how they get installed:"
  local t
  for t in $(module_tools "$module"); do
    printf '    %-12s via %-3s  package: %s\n' \
      "$t" "$(tool_method "$t")" "$(tool_pkg "$t")"
  done
  say ""
  say "  Install everything:   v4zcore install $module"
  say "  Install one tool:     v4zcore install $module --<tool>"
  [ "$module" = "shell" ] && shell_plugins_note
  return 0
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------

cmd_update() {
  banner
  info "Updating Termux package lists and installed packages..."
  run pkg update -y
  run pkg upgrade -y
  if command -v npm >/dev/null 2>&1; then
    local t
    for t in opencode cline; do
      if tool_installed "$t"; then
        info "Updating npm tool: $t"
        run npm update -g "$(tool_pkg "$t")"
      fi
    done
  fi
  ok "Update finished."
  return 0
}

# ---------------------------------------------------------------------------
# env - manage variables in ~/.bashrc or ~/.zshrc (values never printed)
# ---------------------------------------------------------------------------

rc_file() {
  if [ -f "$HOME/.zshrc" ]; then
    echo "$HOME/.zshrc"
  else
    echo "$HOME/.bashrc"
  fi
}

env_set() {
  local rc name value
  rc="$(rc_file)"
  printf 'Variable name: '
  read -r name
  if ! printf '%s' "$name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$'; then
    err "Invalid variable name."
    return 1
  fi
  printf 'Value (hidden): '
  read -rs value
  echo
  touch "$rc"
  # drop any previous v4zcore-managed line for this name
  sed -i "/^export ${name}=.*# v4zcore\$/d" "$rc"
  local esc
  esc="$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
  printf "export %s='%s' # v4zcore\n" "$name" "$esc" >> "$rc"
  ok "Set $name in $(basename "$rc"). Apply with:  source $(basename "$rc")"
}

env_unset() {
  local rc name="${1:-}"
  rc="$(rc_file)"
  if [ -z "$name" ]; then
    info "Variables managed by v4zcore in $(basename "$rc"):"
    grep '# v4zcore$' "$rc" 2>/dev/null | sed -E 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/' | nl -ba
    printf 'Variable name to remove: '
    read -r name
  fi
  if grep -q "^export ${name}=.*# v4zcore\$" "$rc" 2>/dev/null; then
    sed -i "/^export ${name}=.*# v4zcore\$/d" "$rc"
    ok "Removed $name from $(basename "$rc")."
  else
    warn "$name is not managed by v4zcore (nothing removed)."
  fi
}

env_ls() {
  local rc count
  rc="$(rc_file)"
  info "Variables managed by v4zcore ($(basename "$rc")):"
  grep '# v4zcore$' "$rc" 2>/dev/null | sed -E 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1=<redacted>/'
  count="$(grep -c '# v4zcore$' "$rc" 2>/dev/null || true)"
  say "${DIM}${count} variable(s). Values stay hidden.${RESET}"
}

cmd_env() {
  case "${1:-}" in
    set)   env_set ;;
    unset) env_unset "${2:-}" ;;
    ls)    env_ls ;;
    *)
      say "Usage:"
      say "  v4zcore env set           add/update a variable (value typed hidden)"
      say "  v4zcore env unset [NAME]  remove a variable"
      say "  v4zcore env ls            list managed variables (values hidden)"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# brain - tiny local notes ("second brain") as markdown files
# Stored in ~/.v4zcore/brain/<slug>.md with simple frontmatter.
# ---------------------------------------------------------------------------

BRAIN_DIR="$HOME/.v4zcore/brain"

brain_slug() {
  # "My Cool Note" -> "my-cool-note"
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

brain_save() {
  local title="${1:-}"
  if [ -z "$title" ]; then
    err "Usage: v4zcore brain save <title> [tag1,tag2]"
    say "Body comes from stdin, e.g.:  echo 'text' | v4zcore brain save \"My note\""
    return 1
  fi
  local tags="${2:-}"
  local slug file body
  slug="$(brain_slug "$title")"
  [ -z "$slug" ] && slug="note"
  mkdir -p "$BRAIN_DIR"
  file="$BRAIN_DIR/$slug.md"
  if [ -e "$file" ]; then
    slug="$slug-$(date +%H%M%S)"
    file="$BRAIN_DIR/$slug.md"
  fi
  if [ -t 0 ]; then
    say "Write the note, finish with Ctrl+D:"
  fi
  body="$(cat)"
  cat > "$file" <<EOF
---
title: $title
tags: [$tags]
date: $(date +%Y-%m-%d)
---

$body
EOF
  ok "Saved: brain/$slug.md   (read it with: v4zcore brain show $slug)"
  return 0
}

brain_ls() {
  mkdir -p "$BRAIN_DIR"
  local f count=0
  info "Notes in your brain (~/.v4zcore/brain):"
  for f in "$BRAIN_DIR"/*.md; do
    [ -e "$f" ] || continue
    count=$((count + 1))
    local slug title
    slug="$(basename "$f" .md)"
    title="$(sed -n 's/^title: //p' "$f" | head -n 1)"
    printf '  %-24s %s\n' "$slug" "$title"
  done
  [ "$count" -eq 0 ] && say "  ${DIM}(no notes yet - save one: v4zcore brain save \"Title\")${RESET}"
  return 0
}

brain_search() {
  local word="${1:-}"
  if [ -z "$word" ]; then
    err "Usage: v4zcore brain search <word>"
    return 1
  fi
  mkdir -p "$BRAIN_DIR"
  local hits
  hits="$(grep -il -- "$word" "$BRAIN_DIR"/*.md 2>/dev/null)"
  if [ -z "$hits" ]; then
    warn "No notes matching '$word'."
    return 0
  fi
  info "Notes matching '$word':"
  local f
  for f in $hits; do
    printf '  %-24s %s\n' "$(basename "$f" .md)" \
      "$(sed -n 's/^title: //p' "$f" | head -n 1)"
    grep -in -- "$word" "$f" | head -n 2 | sed 's/^/      /'
  done
  return 0
}

brain_show() {
  local slug="${1:-}"
  if [ -z "$slug" ]; then
    err "Usage: v4zcore brain show <slug>   (see slugs with: v4zcore brain ls)"
    return 1
  fi
  local file="$BRAIN_DIR/$slug.md"
  if [ ! -f "$file" ]; then
    err "No such note: $slug"
    say "List notes with:  v4zcore brain ls"
    return 1
  fi
  cat "$file"
  return 0
}

cmd_brain() {
  case "${1:-}" in
    save)   brain_save "${2:-}" "${3:-}" ;;
    search) brain_search "${2:-}" ;;
    ls)     brain_ls ;;
    show)   brain_show "${2:-}" ;;
    *)
      say "Usage:"
      say "  v4zcore brain save <title> [tags]   save a note (body from stdin)"
      say "  v4zcore brain search <word>         find notes containing a word"
      say "  v4zcore brain ls                    list note slugs and titles"
      say "  v4zcore brain show <slug>           print one note"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# pg - PostgreSQL helper (wraps initdb / pg_ctl)
# ---------------------------------------------------------------------------

PGDATA_DIR="$HOME/.v4zcore/pgdata"
PGLOG_FILE="$HOME/.v4zcore/pg.log"

pg_missing() {
  err "PostgreSQL is not installed on this system."
  say "Install it with:  v4zcore install db --postgresql"
  say "Then run:         v4zcore pg init"
  return 1
}

pg_have() {
  command -v initdb >/dev/null 2>&1 && command -v pg_ctl >/dev/null 2>&1
}

cmd_pg() {
  local sub="${1:-}"
  case "$sub" in
    status|start|stop|init) ;;
    *)
      say "Usage: v4zcore pg <status|start|stop|init>"
      say "  init    create the data directory (once)"
      say "  start   start the PostgreSQL server"
      say "  stop    stop the PostgreSQL server"
      say "  status  show whether the server is running"
      return 0
      ;;
  esac
  pg_have || { pg_missing; return 1; }
  case "$sub" in
    init)
      if [ -d "$PGDATA_DIR" ]; then
        warn "Data directory already exists: $PGDATA_DIR"
        return 0
      fi
      mkdir -p "$(dirname "$PGDATA_DIR")"
      run initdb -D "$PGDATA_DIR" && ok "PostgreSQL data directory created: $PGDATA_DIR"
      ;;
    start)
      if [ ! -d "$PGDATA_DIR" ]; then
        err "No data directory yet. Run:  v4zcore pg init"
        return 1
      fi
      run pg_ctl -D "$PGDATA_DIR" -l "$PGLOG_FILE" start \
        && ok "PostgreSQL started. Connect with:  psql -h 127.0.0.1"
      ;;
    stop)
      if [ ! -d "$PGDATA_DIR" ]; then
        err "No data directory yet. Run:  v4zcore pg init"
        return 1
      fi
      run pg_ctl -D "$PGDATA_DIR" stop && ok "PostgreSQL stopped."
      ;;
    status)
      if [ ! -d "$PGDATA_DIR" ]; then
        warn "PostgreSQL is installed but not initialised yet. Run:  v4zcore pg init"
        return 0
      fi
      if pg_isready -h 127.0.0.1 >/dev/null 2>&1 || pg_ctl -D "$PGDATA_DIR" status >/dev/null 2>&1; then
        ok "PostgreSQL is running (data: $PGDATA_DIR)."
      else
        warn "PostgreSQL is not running. Start it with:  v4zcore pg start"
      fi
      ;;
  esac
}

# ---------------------------------------------------------------------------
# init - small original project starter stubs
# ---------------------------------------------------------------------------

cmd_init() {
  local kind="${1:-}" dir="${2:-}"
  case "$kind" in
    python)  dir="${dir:-python-app}" ;;
    node)    dir="${dir:-node-app}" ;;
    react)   dir="${dir:-react-app}" ;;
    express) dir="${dir:-express-app}" ;;
    *)
      err "Usage: v4zcore init <python|node|react|express> [directory]"
      return 1
      ;;
  esac
  if [ -e "$dir" ]; then
    err "Directory already exists: $dir"
    return 1
  fi
  mkdir -p "$dir"
  info "Creating $kind starter project in ./$dir"
  if [ "$kind" = "react" ]; then
    mkdir -p "$dir/src"
    cat > "$dir/package.json" <<EOF
{
  "name": "$dir",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React starter created with V4Z Core",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
EOF
    cat > "$dir/index.html" <<'EOF'
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>React App</title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>
EOF
    cat > "$dir/src/main.jsx" <<'EOF'
import React from "react";
import { createRoot } from "react-dom/client";

function App() {
  return <h1>Hello from your new React project!</h1>;
}

createRoot(document.getElementById("root")).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>
);
EOF
    cat > "$dir/.gitignore" <<'EOF'
node_modules/
dist/
EOF
    cat > "$dir/README.md" <<EOF
# $dir

React (Vite) starter created with V4Z Core.

    npm install
    npm run dev
EOF
  elif [ "$kind" = "express" ]; then
    cat > "$dir/package.json" <<EOF
{
  "name": "$dir",
  "version": "1.0.0",
  "description": "Express starter created with V4Z Core",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "license": "MIT"
}
EOF
    cat > "$dir/index.js" <<'EOF'
// Express starter - edit me.
